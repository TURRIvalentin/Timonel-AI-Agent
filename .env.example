# Ruta absoluta o relativa al directorio donde están los PDFs
PDF_DIRECTORY="C:\Users\valen\OneDrive\Escritorio\Timonel"

# Ruta para guardar la base de datos vectorial localmente
CHROMA_DB_DIR="./chroma_db"

# Proveedor de Embeddings: "huggingface" o "openai"
EMBEDDINGS_PROVIDER="huggingface"

# Proveedor de LLM: "openai" o "local" (ej. ollama)
LLM_PROVIDER="openai"

# API Key de OpenAI (requerida si usas openai como proveedor de embeddings o LLM)
OPENAI_API_KEY="your-openai-api-key-here"

# Nombre del modelo de embeddings (si usas huggingface)
HF_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Nombre del modelo LLM (si usas openai)
OPENAI_MODEL_NAME="gpt-3.5-turbo"
# O si usas local: (asegúrate de tener ollama corriendo y el modelo descargado)
LOCAL_LLM_MODEL="llama3"
