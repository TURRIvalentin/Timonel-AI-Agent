# =============================================================================
# Timonel RAG — Environment Configuration
# Copy this file to .env and fill in your values.
# Lines starting with # are comments and are ignored.
# =============================================================================

# --- Paths ---
# Directory containing source PDF documents.
# Default: <project_root>/data
PDF_DIRECTORY=./data

# Persistence directory for the ChromaDB vector store.
# Regenerated by `python cli.py ingest`; do NOT commit to git.
# Default: <project_root>/chroma_db
CHROMA_DB_DIR=./chroma_db

# SQLite file for query audit logs.
# Default: <project_root>/data/timonel_logs.db
DB_PATH=./data/timonel_logs.db

# --- Providers ---
# Embedding backend: "huggingface" (local, free) | "openai" (requires API key)
EMBEDDINGS_PROVIDER=huggingface

# LLM backend: "openai" (requires API key) | "ollama" (local, requires Ollama running)
LLM_PROVIDER=openai

# --- Models ---
# HuggingFace sentence-transformer model (used when EMBEDDINGS_PROVIDER=huggingface)
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# OpenAI chat model (used when LLM_PROVIDER=openai)
OPENAI_MODEL_NAME=gpt-3.5-turbo

# Ollama model name (used when LLM_PROVIDER=ollama; must be pulled first)
LOCAL_LLM_MODEL=llama3

# --- Retrieval Tuning ---
# Number of document chunks to retrieve per query
RETRIEVER_K=4
# Characters per chunk (min: 100)
CHUNK_SIZE=1000
# Overlapping characters between consecutive chunks (>= 0)
CHUNK_OVERLAP=200

# --- Secrets ---
# Required when EMBEDDINGS_PROVIDER=openai or LLM_PROVIDER=openai.
# Never commit your actual key.
OPENAI_API_KEY=your-openai-api-key-here

# --- Observability ---
# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# --- API server ---
# Port for the FastAPI/uvicorn server (used by Docker and local uvicorn runs).
PORT=8000
